{
  "name": "@local/dsh-subagent-hub",
  "version": "0.3.0",
  "license": "MIT",
  "author": "ddaada11",
  "type": "module",
  "description": "Subagent hub: a composer button that drives the built-in Agent Teams runtime (spawn, message, interrupt, task board) from the chat box.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "subagent",
    "agent-teams"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddaada11/dsh-subagent-hub.git"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  }
}
